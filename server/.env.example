# Configuration de la base de données (Railway PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/database

# Configuration de sécurité
SECRET_KEY=votre-cle-secrete-tres-longue-et-aleatoire

# Configuration CORS (origines autorisées)
CORS_ORIGINS=*

# Configuration Email (Flask-Mail)
# Pour Gmail, activez "Autoriser les applications moins sécurisées" ou utilisez un mot de passe d'application
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=votre-email@gmail.com
MAIL_PASSWORD=votre-mot-de-passe-app
MAIL_DEFAULT_SENDER=noreply@masterofisland.com

# Alternative: SendGrid
# MAIL_SERVER=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USE_TLS=True
