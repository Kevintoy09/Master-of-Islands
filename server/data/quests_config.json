{
  "description": "Configuration des quêtes quotidiennes et hebdomadaires par niveau de joueur",
  "level_calculation": {
    "formula": "min(50, (cities * 5) + (days_played * 0.5) + (construction_points / 20) + (research_points / 50) + (victories * 2))",
    "explanation": "Le niveau du joueur est calculé en fonction de sa progression globale, plafonné à 50"
  },
